
{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "lc-prompt-studio-api",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
